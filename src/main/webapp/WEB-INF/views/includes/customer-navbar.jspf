<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<header class="market-header">
    <div class="container market-header__inner">
        <a class="brand" href="${pageContext.request.contextPath}/customer/dashboard">
            <img class="brand__logo" src="${pageContext.request.contextPath}/assets/images/quickfix-wordmark.png" alt="QuickFix">
        </a>
        <nav class="market-nav" aria-label="Customer navigation">
            <a class="market-nav__link ${activeNav == 'home' ? 'market-nav__link--active' : ''}" href="dashboard">Home</a>
            <a class="market-nav__link ${activeNav == 'services' ? 'market-nav__link--active' : ''}" href="search-services">Services</a>
            <a class="market-nav__link ${activeNav == 'bookings' ? 'market-nav__link--active' : ''}" href="booking-history">My Bookings</a>
            <a class="market-nav__link ${activeNav == 'feedback' ? 'market-nav__link--active' : ''}" href="feedback">Feedback</a>
            <a class="market-nav__link ${activeNav == 'complaints' ? 'market-nav__link--active' : ''}" href="complaints">My Complaints</a>
        </nav>
        <div class="market-header__actions">
            <div class="notification-tray">
                <button class="market-icon-button" type="button" aria-label="Notifications" onclick="document.getElementById('nav-notifications').classList.toggle('is-open')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none;"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    <c:if test="${unreadNotificationCount > 0}"><span class="notification-button__badge"><c:out value="${unreadNotificationCount}"/></span></c:if>
                </button>
                <div id="nav-notifications" class="notification-tray__list">
                    <c:forEach items="${notifications}" var="n"><div class="notification-tray__item ${n.read ? '' : 'notification-tray__item--unread'}"><strong>${n.title}</strong><span>${n.message}</span></div></c:forEach>
                    <c:if test="${empty notifications}"><div class="notification-tray__item">No notifications.</div></c:if>
                    <c:if test="${not empty notifications}">
                        <form method="post" style="margin:0; padding:0;">
                            <input type="hidden" name="action" value="markNotificationsRead">
                            <button type="submit" class="notification-tray__action" style="background:none; border:none; width:100%; text-align:center; cursor:pointer;">Mark all read</button>
                        </form>
                    </c:if>
                </div>
            </div>
            <span class="market-profile">Profile</span>
            <a class="btn btn--secondary btn--sm" data-logout-link href="${pageContext.request.contextPath}/logout">Logout</a>
        </div>
    </div>
</header>
<%@ include file="logout-confirm.jspf" %>
<script src="${pageContext.request.contextPath}/assets/js/main.js" defer></script>
