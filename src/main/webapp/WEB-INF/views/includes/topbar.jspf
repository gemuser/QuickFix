<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<header class="topbar">
    <div>
        <h2 class="topbar__title">${pageTitle}</h2>
        <p class="topbar__meta">${pageSubtitle}</p>
    </div>
    <div class="topbar__actions">
        <div class="notification-tray">
            <button class="notification-button" type="button" aria-label="Notifications" onclick="document.getElementById('topbar-notifications').classList.toggle('is-open')">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="pointer-events: none;"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                <c:if test="${unreadNotificationCount > 0}"><span class="notification-button__badge"><c:out value="${unreadNotificationCount}"/></span></c:if>
            </button>
            <div id="topbar-notifications" class="notification-tray__list">
                <c:forEach items="${notifications}" var="n"><div class="notification-tray__item ${n.read ? '' : 'notification-tray__item--unread'}"><strong>${n.title}</strong><span>${n.message}</span></div></c:forEach>
                <c:if test="${empty notifications}"><div class="notification-tray__item">No notifications.</div></c:if>
                <c:if test="${not empty notifications}">
                    <form method="post" style="margin:0; padding:0;">
                        <input type="hidden" name="action" value="markNotificationsRead">
                        <button type="submit" class="notification-tray__action" style="background:none; border:none; width:100%; text-align:center; cursor:pointer;">Mark all read</button>
                    </form>
                </c:if>
            </div>
        </div>
        <div class="profile-chip">
            <span class="profile-chip__avatar">Q</span>
            <span>
                <span class="profile-chip__name">${empty sessionScope.user.fullName ? 'QuickFix User' : sessionScope.user.fullName}</span>
                <span class="profile-chip__role">${navRole}</span>
            </span>
        </div>
    </div>
</header>
